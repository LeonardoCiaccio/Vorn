{
  "name": "vorn",
  "version": "1.0.2",
  "description": "Vorn — Vault Of Redundant Nodes",
  "license": "AGPL-3.0-only",
  "author": "Leonardo Ciaccio <leonardo.ciaccio@gmail.com>",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.1.4"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "better-sqlite3": "^12.9.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.0",
    "vue-virtual-scroller": "^3.0.3"
  },
  "build": {
    "appId": "com.vorn.app",
    "productName": "Vorn",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icons/icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icons/icon.ico"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "artifactName": "Vorn-Windows.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "artifactName": "Vorn-Linux.${ext}"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": ["universal"]
      },
      "icon": "build/icon.png",
      "artifactName": "Vorn-macOS.${ext}"
    }
  }
}
